# Copy to .env.local and fill in. Never commit real secrets.

# MongoDB — include the database name in the path (…mongodb.net/wishlist?…)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/wishlist?retryWrites=true&w=majority

# NextAuth — generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Email transport: `smtp` (the default when unset) sends mail through the SMTP_*
# server below; `console` sends nothing and prints each email (recipient,
# subject, magic link) to the dev-server terminal, so local dev needs no SMTP
# account. `console` is only allowed locally (VERCEL_ENV unset) or in the Vercel
# Development environment; it's refused on Preview and Production deployments.
EMAIL_TRANSPORT=console

# SMTP (magic-link emails): required when EMAIL_TRANSPORT is smtp, optional in console mode
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@yourdomain.com

# Guards the migration endpoints
MIGRATION_SECRET=

# Production only: Vercel Cron sends it as a bearer token to /api/cron/* (the
# monthly snapshot sweep, the daily occasion reminders). Any long random string, e.g. `openssl rand -hex 32`.
CRON_SECRET=

# Cron heartbeats (healthchecks.io) — OPTIONAL, production only. One check per
# cron: paste its https ping URL; after each successful run the cron pings it
# (counts only), so a run that fails or never comes raises the check's alert.
# Unset ⇒ that cron pings nothing.
HEALTHCHECK_URL_SWEEP_SNAPSHOTS=
HEALTHCHECK_URL_OCCASION_REMINDERS=
HEALTHCHECK_URL_BIRTHDAYS=
HEALTHCHECK_URL_GIFT_REMINDERS=

# Vercel Blob (image uploads) — read by the Blob SDK. The store ID inside it also
# decides which blob URLs count as ours; without it no blob is ever deleted.
BLOB_READ_WRITE_TOKEN=

# Rate limiting (Upstash Redis) — OPTIONAL. When unset, rate limiting is
# disabled (fine for local dev). Set BOTH in production to enforce limits.
# Create a free database at https://console.upstash.com and copy its REST creds.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile (bot check on the sign-in form) — OPTIONAL. Set BOTH to
# turn it on, or NEITHER to leave it off (local dev, CI, E2E); setting just one
# is refused at startup. Real keys come from a Turnstile widget in the Cloudflare
# dashboard, and only work on the hostnames registered on that widget. To try the
# widget locally without an account, use Cloudflare's always-pass test keys:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Product analytics (Umami Cloud, cookie-less) — OPTIONAL, Production only. The
# website id (a UUID) from the Umami dashboard. It only takes effect where
# VERCEL_ENV=production, so leave it unset locally: dev, CI, E2E, previews and
# staging never load the script or send anything.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
