{
  "name": "wishlist2",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --port $(node scripts/dev-port.mjs)",
    "build": "next build",
    "check:trace": "node scripts/check-native-trace.mjs",
    "smoke:deploy": "node scripts/smoke-deploy.mjs",
    "generate:email-logo": "node scripts/generate-email-logo.mjs",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "playwright test",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,mts,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,mts,json,css,md}\"",
    "vercel:env": "vercel env pull .env",
    "release:preview": "git fetch origin --quiet && git log --oneline --no-merges origin/main..origin/staging",
    "release": "git fetch origin --quiet && git push origin origin/staging:main"
  },
  "overrides": {
    "nodemailer": "^10.0.13",
    "postcss": "^8.5.22",
    "sharp": "^0.35.5",
    "brace-expansion": "5.0.12",
    "minimatch": "^10.2.5"
  },
  "dependencies": {
    "@auth/mongodb-adapter": "^3.11.1",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/blob": "^2.6.1",
    "@vercel/functions": "^3.9.10",
    "mongodb": "^6.20.0",
    "mongoose": "^8.19.2",
    "next": "16.3.8",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^10.0.13",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-easy-crop": "^6.2.2",
    "sharp": "^0.35.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.1.16",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "jsdom": "^29.1.1",
    "mongodb-memory-server": "^11.2.0",
    "postcss": "^8.5.22",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
