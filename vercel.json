{
  "framework": "nextjs",
  "regions": ["arn1"],
  "git": {
    "deploymentEnabled": {
      "**": false,
      "staging": true,
      "main": true
    }
  },
  "crons": [
    {
      "path": "/api/cron/sweep-snapshots",
      "schedule": "0 3 1 * *"
    },
    {
      "path": "/api/cron/occasion-reminders",
      "schedule": "0 6 * * *"
    }
  ]
}
